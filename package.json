{
  "name": "syslink",
  "private": true,
  "version": "0.1.0",
  "description": "VS Code extension and local daemon for AI-driven OS-level automation",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start:extension": "code --extensionDevelopmentPath=packages/extension"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24"
  }
}
